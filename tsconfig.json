{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "lib": ["ES2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
        "module": "nodenext",
        "target": "ES2024",
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["./src/**/*.ts", "./__tests__/**/*.ts"]
}
